<!-- filepath: sections/custom-page-section.liquid -->
<style>
    body {
      margin: 0;
      font-family: "Helvetica Neue", Arial, sans-serif;
      background-color: #f8f0ea; /* matches screenshot bg */
      color: #333;
    }
    
    .custom-jewellery {
      margin-bottom: -80px;
    }

    {% # This is First Screen CSS %}

    .first-screen {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 88vh;
      gap: 40px;
    }

    .section-1 {
      flex: 1;
      height:100%;
      background-repeat: no-repeat;
      background-position: center;
      background-size: cover
    }

    .section-2 {
      flex: 1;
      text-align: center;
    }

  .subtitle {
        font-size: 12px;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 10px;
        color: #555;
      }

      .title {
        font-size: 36px;
        font-weight: 500;
        margin-bottom: 20px;
      }

      .description {
        font-size: 16px;
        line-height: 1.6;
        color: #444;
        margin-bottom: 30px;
      }

      .cta {
        font-size: 14px;
        text-transform: uppercase;
        text-decoration: none;
        color: #000;
        border-bottom: 1px solid #000;
        padding-bottom: 4px;
        transition: color 0.3s ease, border-color 0.3s ease;
      }

      .cta:hover {
        color: #555;
        border-color: #555;
      }

      {% # This is Second Screen CSS %}

    .second-screen {
      display: none;
      justify-content: center;
      height: 88vh;
      align-items: stretch;
    }

    .card {
      position: relative;
      flex: 1;
      background-size: cover;
      background-position: center;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      color: #fff;
      transition: transform 0.3s ease, filter 0.3s ease;
      background-repeat: no-repeat;
      background-position: center;
      background-size: cover
    }

    .card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.15); /* dark overlay for text visibility */
    }

    .card-content {
      position: relative;
      z-index: 1;
    }

    .card h2 {
      font-size: 28px;
      margin: 0 0 10px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .card a {
      font-size: 14px;
      text-transform: uppercase;
      text-decoration: none;
      color: #fff;
      border-bottom: 1px solid #fff;
      padding-bottom: 4px;
      transition: color 0.3s ease, border-color 0.3s ease;
    }

    .card:hover {
      transform: scale(1.02);
      filter: brightness(1.05);
      cursor:pointer
    }

    .card a:hover {
      color: #ddd;
      border-color: #ddd;
    }

    @media (max-width: 768px) {
      .first-screen {
        flex-direction: column;
        text-align: center;
      }
      .section-1 {
        width: 100%;
        min-height: 250px;
      }
      .section-2 {
        width: 100%;
      }
      .second-screen {
        flex-direction: column;
      }
      .card {
        min-height: 300px;
      }
    }

    {% # This is Third Screen CSS %}

    .third-screen {
      display: none;
      align-items: center;
      justify-content: center;
      height: 88vh;
    }

    .third-screen-section-1 {
      flex: 1;
      height:100%;
      background-repeat: no-repeat;
      background-position: center;
      background-size: cover
    }

    .third-screen-section-2 {
      flex: 1;
      height: 100%;
    }


.panel-section {
  margin-bottom: 12px;
  position: relative;
  padding-bottom: 8px;
  border-bottom: 1px solid #eee;
}

.section-title {
  font-size: 14px;
  font-weight: 600;
  margin: 0 0 12px 0;
  color: #333;
}

.options-grid {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.option {
  display: flex;
  flex-direction: column;
  align-items: center;
  cursor: pointer;
  border: 1px solid transparent;
  border-radius: 6px;
  padding: 6px;
  transition: all 0.2s ease-in-out;
}

.option img {
  width: 100%;
  height: auto;
  border-radius: 6px;
}

.option p {
  margin: 8px 0 0;
  font-size: 13px;
  color: #444;
}

.option:hover {
  border-color: #ccc;
  background: #fdfdfd;
}

.option.selected {
  border: 1px solid #000;
}

.expand-btn {
  position: absolute;
  right: 0;
  top: 0;
  background: none;
  border: none;
  font-size: 18px;
  cursor: pointer;
  color: #555;
}

.charms-count {
  display: inline-block;
  font-size: 12px;
  color: #777;
  margin-left: 10px;
}

  .container {
      display: grid;
      grid-template-columns: 250px 1fr;
        height:88vh;
    }

    .left-panel {
      background: #f4f0eb;
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

.right-panel {
padding: 20px;
}

.grid-container {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 30px;
      max-width: 800px;
      margin: auto;
    }

    .grid-item {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .grid-item img {
      width: 100%;
      height: auto;
      border-radius: 6px;
      object-fit: cover;
    }

    .label {
      margin-top: 10px;
      font-size: 14px;
      font-weight: 500;
      letter-spacing: 1px;
      color: #333;
    }

    /* ✅ Checkmark for selected item */
    .selected::before {
      content: "✔";
      position: absolute;
      top: 10px;
      left: 10px;
      width: 24px;
      height: 24px;
      background: white;
      border-radius: 50%;
      border: 2px solid black;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      font-weight: bold;
      color: black;
    }

</style>

<div class="custom-jewellery">
  <div class="first-screen">
    <div class="section-1" style="background-image: url('{{ section.settings.hero_image | image_url }}');">
    </div>
    <div class="section-2" >
      <div class="subtitle">{{ section.settings.hero_subtitle }}</div>
      <div class="title">{{ section.settings.hero_title }}</div>
      <div class="description">
      {{ section.settings.hero_description }}
      </div>
      <a id="create_cta_btn" class="cta">{{ section.settings.hero_cta_button }}</a>
    </div>
  </div>

  <div class="second-screen">
    <div id="necklace-card" class="card" style="background-image: url('{{ section.settings.necklace_image | image_url }}');">
      <div class="card-content">
        <h2>Necklace</h2>
        <a>Select</a>
      </div>
    </div>

    <!-- Anklet -->
    <div id="anklet-card" class="card" style="background-image: url('{{ section.settings.anklet_image | image_url }}')">
      <div class="card-content">
        <h2>Anklet</h2>
        <a>Select</a>
      </div>
    </div>

    <!-- Bracelet -->
    <div id="bracelet-card" class="card" style="background-image: url('{{ section.settings.bracelet_image | image_url }}')">
      <div class="card-content">
        <h2>Bracelet</h2>
        <a>Select</a>
      </div>
    </div>
  </div>

  <div class="third-screen" >
      <div class="third-screen-section-1" style="background-image: url('{{ section.settings.third_screen_bg_image | image_url }}');">
      </div>
      <div id="third-screen-section-2" class="third-screen-section-2">

      </div>
  </div>

</div>

<script src="{{ 'vite-app.js' | asset_url }}" ></script>

<script>
 document.addEventListener('DOMContentLoaded', () => {
    let customProduct = {};

    // Get the button and the div
    const createButton = document.getElementById('create_cta_btn');
    const firstScreen = document.querySelector('.first-screen');
    const secondScreen = document.querySelector('.second-screen')
    const thirdScreen = document.querySelector('.third-screen')
    const thirdScreenSecondSection = document.getElementById('third-screen-section-2');

    // Add a click event listener to the button
    createButton.addEventListener('click', (event) => {
      event.preventDefault(); // Prevent default link behavior
      if (firstScreen) {
        firstScreen.style.display = 'none'; // Hide the div
        secondScreen.style.display = 'flex'; // show the div

        const necklaceCard = document.getElementById('necklace-card')
        const ankletCard = document.getElementById('anklet-card')
        const braceletCard = document.getElementById('bracelet-card')

        function showThirdScreen(productType){
          secondScreen.style.display = 'none';
          thirdScreen.style.display = 'flex';

          thirdScreenSecondSection.setAttribute('data-product-type', productType); 
        }

        necklaceCard.addEventListener('click',(event) => {
          customProduct['product_type'] = 'Necklace'
          showThirdScreen('Necklace')
        })
        ankletCard.addEventListener('click',(event) => {
          customProduct['product_type'] = 'Anklet'
          showThirdScreen('Anklet')
        })
        braceletCard.addEventListener('click',(event) => {
          customProduct['product_type'] = 'Bracelet'
          showThirdScreen('Bracelet')
        })
      }
    });

  });
</script>

{% schema %}
{
  "name": "Bespoke Visualiser Page",
  "settings": [
    {
      "type": "header",
      "content": "Screen 1 Settings"
    },
    {
      "type": "text",
      "id": "hero_subtitle",
      "label": "Hero Section Subtitle",
      "default": "Your Story, Your stack"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Section Title",
      "default": "THE STORY CHAIN®"
    },
    {
      "type": "textarea",
      "id": "hero_description",
      "label": "Hero Section Description",
      "default": "Create your own personalised solid gold Story Chain® necklace, bracelet or anklet with our online builder, and mark every moment of your story with meaningful charms."
    },
    {
      "type": "text",
      "id": "hero_cta_button",
      "label": "Cta Button Text",
      "default": "CREATE YOUR STORY"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Section Background Image"
    },
    {
      "type": "header",
      "content": "Screen 2 Settings"
    },
    {
      "type": "image_picker",
      "id": "necklace_image",
      "label": "Necklace Background Image"
    },
    {
      "type": "image_picker",
      "id": "anklet_image",
      "label": "Anklet Background Image"
    },
    {
      "type": "image_picker",
      "id": "bracelet_image",
      "label": "Bracelet Background Image"
    },
    {
      "type": "header",
      "content": "Screen 3 Settings"
    },
    {
      "type": "image_picker",
      "id": "third_screen_bg_image",
      "label": "Third Screen Background Image"
    },
  ]
}
{% endschema %}