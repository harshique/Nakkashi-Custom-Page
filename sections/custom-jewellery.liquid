<!-- filepath: sections/custom-page-section.liquid -->
<style>
    body {
      margin: 0;
      font-family: "Helvetica Neue", Arial, sans-serif;
      background-color: #f8f0ea; /* matches screenshot bg */
      color: #333;
    }

    .two-div-layout {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 80vh;
      padding: 40px;
      gap: 40px;
    }

    .section-1 {
      flex: 1;
      background: url("your-image.jpg") center/cover no-repeat;
      border-radius: 12px;
      min-height: 400px;
    }

    .section-2 {
      flex: 1;
      text-align: center;
    }

  .subtitle {
        font-size: 12px;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 10px;
        color: #555;
      }

      .title {
        font-size: 36px;
        font-weight: 500;
        margin-bottom: 20px;
      }

      .description {
        font-size: 16px;
        line-height: 1.6;
        color: #444;
        margin-bottom: 30px;
      }

      .cta {
        font-size: 14px;
        text-transform: uppercase;
        text-decoration: none;
        color: #000;
        border-bottom: 1px solid #000;
        padding-bottom: 4px;
        transition: color 0.3s ease, border-color 0.3s ease;
      }

      .cta:hover {
        color: #555;
        border-color: #555;
      }

</style>

<div class="custom-jewellery">
  <div class="two-div-layout">
    <div class="section-1" style="background-image: url({{ section.settings.hero_image | file_url }});">
    </div>
    <div class="section-2" >
      <div class="subtitle">{{ section.settings.hero_subtitle }}</div>
      <div class="title">{{ section.settings.hero_title }}</div>
      <div class="description">
      {{ section.settings.hero_description }}
      </div>
      <a href="#" class="cta">{{ section.settings.hero_cta_button }}</a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Bespoke Visualiser Page",
  "settings": [
    {
      "type": "text",
      "id": "hero_subtitle",
      "label": "Hero Section Subtitle",
      "default": "Your Story, Your stack"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Section Title",
      "default": "THE STORY CHAIN®"
    },
    {
      "type": "textarea",
      "id": "hero_description",
      "label": "Hero Section Description",
      "default": "Create your own personalised solid gold Story Chain® necklace, bracelet or anklet with our online builder, and mark every moment of your story with meaningful charms."
    },
    {
      "type": "text",
      "id": "hero_cta_button",
      "label": "Cta Button Text",
      "default": "CREATE YOUR STORY"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Section Background Image"
    },
  ]
}
{% endschema %}