<!-- filepath: sections/custom-page-section.liquid -->
<style>
    body {
      margin: 0;
      font-family: "Helvetica Neue", Arial, sans-serif;
      background-color: #f8f0ea; /* matches screenshot bg */
      color: #333;
    }
    
    .custom-jewellery {
      margin-bottom: -80px;
    }

    .two-div-layout {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 88vh;
      gap: 40px;
    }

    .section-1 {
      flex: 1;
      height:100%;
      background-repeat: no-repeat;
      background-position: center;
      background-size: cover
    }

    .section-2 {
      flex: 1;
      text-align: center;
    }

  .subtitle {
        font-size: 12px;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 10px;
        color: #555;
      }

      .title {
        font-size: 36px;
        font-weight: 500;
        margin-bottom: 20px;
      }

      .description {
        font-size: 16px;
        line-height: 1.6;
        color: #444;
        margin-bottom: 30px;
      }

      .cta {
        font-size: 14px;
        text-transform: uppercase;
        text-decoration: none;
        color: #000;
        border-bottom: 1px solid #000;
        padding-bottom: 4px;
        transition: color 0.3s ease, border-color 0.3s ease;
      }

      .cta:hover {
        color: #555;
        border-color: #555;
      }

    .three-div-layout {
      display: none;
      justify-content: center;
      height: 88vh;
      align-items: stretch;
    }

    .card {
      position: relative;
      flex: 1;
      background-size: cover;
      background-position: center;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      color: #fff;
      transition: transform 0.3s ease, filter 0.3s ease;
      background-repeat: no-repeat;
      background-position: center;
      background-size: cover
    }

    .card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.15); /* dark overlay for text visibility */
    }

    .card-content {
      position: relative;
      z-index: 1;
    }

    .card h2 {
      font-size: 28px;
      margin: 0 0 10px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .card a {
      font-size: 14px;
      text-transform: uppercase;
      text-decoration: none;
      color: #fff;
      border-bottom: 1px solid #fff;
      padding-bottom: 4px;
      transition: color 0.3s ease, border-color 0.3s ease;
    }

    .card:hover {
      transform: scale(1.02);
      filter: brightness(1.05);
      cursor:pointer
    }

    .card a:hover {
      color: #ddd;
      border-color: #ddd;
    }

    @media (max-width: 768px) {
      .two-div-layout {
        flex-direction: column;
        text-align: center;
      }
      .section-1 {
        width: 100%;
        min-height: 250px;
      }
      .section-2 {
        width: 100%;
      }
      .three-div-layout {
        flex-direction: column;
      }
      .card {
        min-height: 300px;
      }
    }

</style>

<div class="custom-jewellery">
  <div class="two-div-layout">
    <div class="section-1" style="background-image: url('{{ section.settings.hero_image | image_url }}');">
    </div>
    <div class="section-2" >
      <div class="subtitle">{{ section.settings.hero_subtitle }}</div>
      <div class="title">{{ section.settings.hero_title }}</div>
      <div class="description">
      {{ section.settings.hero_description }}
      </div>
      <a id="create_cta_btn" class="cta">{{ section.settings.hero_cta_button }}</a>
    </div>
  </div>

  <div class="three-div-layout">
    <div id="necklace-card" class="card" style="background-image: url('{{ section.settings.necklace_image | image_url }}');">
      <div class="card-content">
        <h2>Necklace</h2>
        <a>Select</a>
      </div>
    </div>

    <!-- Anklet -->
    <div id="anklet-card" class="card" style="background-image: url('{{ section.settings.anklet_image | image_url }}')">
      <div class="card-content">
        <h2>Anklet</h2>
        <a>Select</a>
      </div>
    </div>

    <!-- Bracelet -->
    <div id="bracelet-card" class="card" style="background-image: url('{{ section.settings.bracelet_image | image_url }}')">
      <div class="card-content">
        <h2>Bracelet</h2>
        <a>Select</a>
      </div>
    </div>
  </div>
</div>

<script>
 document.addEventListener('DOMContentLoaded', () => {
    let customProduct = {};

    // Get the button and the div
    const createButton = document.getElementById('create_cta_btn');
    const twoDivLayout = document.querySelector('.two-div-layout');
    const threeDivLayout = document.querySelector('.three-div-layout')

    // Add a click event listener to the button
    createButton.addEventListener('click', (event) => {
      event.preventDefault(); // Prevent default link behavior
      if (twoDivLayout) {
        twoDivLayout.style.display = 'none'; // Hide the div
        threeDivLayout.style.display = 'flex'; // show the div

        const necklaceCard = document.getElementById('necklace-card')
        const ankletCard = document.getElementById('anklet-card')
        const braceletCard = document.getElementById('bracelet-card')

        necklaceCard.addEventListener('click',(event) => {
          customProduct['product_type'] = 'Necklace'
          console.log(customProduct)
        })
        ankletCard.addEventListener('click',(event) => {
          customProduct['product_type'] = 'Anklet'
        })
        braceletCard.addEventListener('click',(event) => {
          customProduct['product_type'] = 'Bracelet'
        })
      }
    });

  });
</script>

{% schema %}
{
  "name": "Bespoke Visualiser Page",
  "settings": [
    {
      "type": "header",
      "content": "Page 1 Settings"
    },
    {
      "type": "text",
      "id": "hero_subtitle",
      "label": "Hero Section Subtitle",
      "default": "Your Story, Your stack"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Section Title",
      "default": "THE STORY CHAIN®"
    },
    {
      "type": "textarea",
      "id": "hero_description",
      "label": "Hero Section Description",
      "default": "Create your own personalised solid gold Story Chain® necklace, bracelet or anklet with our online builder, and mark every moment of your story with meaningful charms."
    },
    {
      "type": "text",
      "id": "hero_cta_button",
      "label": "Cta Button Text",
      "default": "CREATE YOUR STORY"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Section Background Image"
    },
    {
      "type": "header",
      "content": "Page 2 Settings"
    },
    {
      "type": "image_picker",
      "id": "necklace_image",
      "label": "Necklace Background Image"
    },
    {
      "type": "image_picker",
      "id": "anklet_image",
      "label": "Anklet Background Image"
    },
    {
      "type": "image_picker",
      "id": "bracelet_image",
      "label": "Bracelet Background Image"
    },
  ]
}
{% endschema %}