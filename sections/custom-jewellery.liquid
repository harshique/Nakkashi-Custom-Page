<style>
    body {
      margin: 0;
      font-family: "Helvetica Neue", Arial, sans-serif;
      background-color: #f8f0ea; /* matches screenshot bg */
      color: #333;
    }
    
    .custom-jewellery {
      margin-bottom: -80px;
    }

    {% # This is First Screen CSS %}

    .first-screen {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 88vh;
      gap: 40px;
    }

    .section-1 {
      flex: 1;
      height:100%;
      background-repeat: no-repeat;
      background-position: center;
      background-size: cover
    }

    .section-2 {
      flex: 1;
      text-align: center;
    }

  .subtitle {
        font-size: 12px;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 10px;
        color: #555;
      }

      .title {
        font-size: 36px;
        font-weight: 500;
        margin-bottom: 20px;
      }

      .description {
        font-size: 16px;
        line-height: 1.6;
        color: #444;
        margin-bottom: 30px;
      }

      .cta {
        font-size: 14px;
        text-transform: uppercase;
        text-decoration: none;
        color: #000;
        border-bottom: 1px solid #000;
        padding-bottom: 4px;
        transition: color 0.3s ease, border-color 0.3s ease;
      }

      .cta:hover {
        color: #555;
        border-color: #555;
      }

      {% # This is Second Screen CSS %}

    .second-screen {
      display: none;
      justify-content: center;
      height: 88vh;
      align-items: stretch;
    }

    .card {
      position: relative;
      flex: 1;
      background-size: cover;
      background-position: center;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      color: #fff;
      transition: transform 0.3s ease, filter 0.3s ease;
      background-repeat: no-repeat;
      background-position: center;
      background-size: cover
    }

    .card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.15); /* dark overlay for text visibility */
    }

    .card-content {
      position: relative;
      z-index: 1;
    }

    .card h2 {
      font-size: 28px;
      margin: 0 0 10px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .card a {
      font-size: 14px;
      text-transform: uppercase;
      text-decoration: none;
      color: #fff;
      border-bottom: 1px solid #fff;
      padding-bottom: 4px;
      transition: color 0.3s ease, border-color 0.3s ease;
    }

    .card:hover {
      transform: scale(1.02);
      filter: brightness(1.05);
      cursor:pointer
    }

    .card a:hover {
      color: #ddd;
      border-color: #ddd;
    }

    @media (max-width: 768px) {
      .first-screen {
        flex-direction: column;
        text-align: center;
      }
      .section-1 {
        width: 100%;
        min-height: 250px;
      }
      .section-2 {
        width: 100%;
      }
      .second-screen {
        flex-direction: column;
      }
      .card {
        min-height: 300px;
      }
    }

    {% # This is Third Screen CSS %}

    .third-screen {
      display: none;
      align-items: center;
      justify-content: center;
      height: 88vh;
    }

    .third-screen-section-1 {
      flex: 1;
      height:100%;
      background-repeat: no-repeat;
      background-position: center;
      background-size: cover
    }

    .third-screen-section-2 {
      flex: 1;
      height: 100%;
    }


.panel-section {
  margin-bottom: 12px;
  position: relative;
  padding-bottom: 8px;
  border-bottom: 1px solid #eee;
  cursor: pointer;
}

.panel-section-disabled {
  cursor: no-drop;
}

.section-title {
  font-size: 14px;
  font-weight: 600;
  margin: 0 0 12px 0;
  color: #333;
}

.expand-btn {
  position: absolute;
  right: 0;
  top: 0;
  background: none;
  border: none;
  font-size: 18px;
  cursor: pointer;
  color: #555;
}

.charms-count {
  display: inline-block;
  font-size: 12px;
  color: #777;
  margin-left: 10px;
}

  .main-container {
      display: grid;
      grid-template-columns: 250px 1fr;
        height:88vh;
    }

    .left-panel {
      background: #f4f0eb;
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

.right-panel {
padding: 20px;
overflow: auto;
max-height:88vh;
}

.grid-container {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 30px;
      max-width: 800px;
      margin: auto;
      margin-bottom:40px;
    }

    .grid-item {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .grid-item img {
      width: 100%;
      height: auto;
      border-radius: 6px;
      object-fit: cover;
    }

    .label {
      margin-top: 10px;
      font-size: 14px;
      font-weight: 500;
      letter-spacing: 1px;
      color: #333;
    }

    /* ✅ Checkmark for selected item */
    .selected::before {
      content: "✔";
      position: absolute;
      top: 10px;
      left: 10px;
      width: 24px;
      height: 24px;
      background: white;
      border-radius: 50%;
      border: 2px solid black;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      font-weight: bold;
      color: black;
    }

.highlighted {
  background-color: #f0f8ff; /* Light blue background */
  border: 1px solid #007bff; /* Blue border */
  border-radius: 6px;
  padding: 10px;
}


.options-container {
  display: flex;
  flex-direction: column;
  gap: 14px;
  width: 100%;
}

.length-option {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  padding: 12px;
  border: 2px solid #e0dcd7;
  border-radius: 999px;
  background: #f7f0eb;
  font-size: 17px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.length-option-label {
  flex: 1;
  text-align: left;
}

.length-option-circle {
  width: 24px;
  height: 24px;
  border: 2px solid #d6d3d0;
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
}

.length-option-selected {
  background: #fff;
  border: 2px solid #000;
}

.length-option-selected .length-option-circle {
  border: 2px solid #000;
}

.length-option-selected .length-option-circle::after {
  content: "✔";
  font-size: 14px;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -48%);
}

.charms-container {
            margin: 0 auto;
            max-height: 88vh;
            overflow:"auto";
        }

        .distance-label {
            font-size: 16px;
            color: #666;
            margin-bottom: 15px;
            font-weight: 400;
        }

        .distance-options {
            display: flex;
            gap: 20px;
            padding-bottom: 20px;
            border-bottom: 1px solid #ddd;
        }

        .distance-option {
            font-size: 16px;
            color: #999;
            cursor: pointer;
            transition: color 0.2s;
        }

        .distance-option.active {
            color: #333;
            text-decoration: underline;
            font-weight: 500;
        }

        .charm-section {
            border-bottom: 1px solid #ddd;
            padding-top:14px;
        }

        .charm-section:last-child {
            border-bottom: none;
        }

        .charm-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            user-select: none;
            margin-bottom: 10px;
        }

        .charm-title {
            font-size: 16px;
            font-weight: 400;
            color: #333;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

        .charm-count {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 12px;
            color: #666;
        }

        .dropdown-arrow {
            width: 0;
            height: 0;
            border-left: 6px solid transparent;
            border-right: 6px solid transparent;
            border-top: 8px solid #666;
            transition: transform 0.2s;
        }

        .charm-header:hover .charm-title {
            color: #000;
        }

        .charm-header:hover .dropdown-arrow {
            border-top-color: #333;
        }

        /* Responsive design */
        @media (max-width: 480px) {
            .container {
                padding: 15px;
            }
            
            .distance-options {
                gap: 15px;
            }
            
            .charm-title {
                font-size: 16px;
            }
            
            .charm-count {
                font-size: 14px;
            }
        }

.quantity-selector {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 20px;
            margin-top: 20px;
            margin-bottom:10px;
        }

        .quantity-btn {
            width: 36px;
            height: 36px;
            border: 2px solid #999;
            background: transparent;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s;
            font-size: 20px;
            color: #666;
        }

        .quantity-btn:hover {
            border-color: #333;
            color: #333;
        }

        .quantity-btn:active {
            transform: scale(0.95);
        }

        .quantity-display {
            font-size: 24px;
            color: #333;
            min-width: 40px;
            text-align: center;
        }
        section.m-announcement-bar {
    display: none;
}



      .confirm-button {
            width: 50%;
            background-color: #3a3a3a;
            color: #ffffff;
            border: none;
            padding: 20px 30px;
            font-size: 18px;
            font-weight: 400;
            letter-spacing: 1px;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.3s ease;
            position: fixed;
            bottom: 0;
            right: 0;
            border-radius: 0;
            overflow: hidden;
            z-index: 1000;
            box-shadow: 0 -4px 20px rgba(0,0,0,0.15);
            cursor: pointer;
        }

        .confirm-button:hover {
            background-color: #2a2a2a;
            transform: none;
            box-shadow: 0 -6px 25px rgba(0,0,0,0.25);
        }

        .confirm-button:active {
            transform: none;
            box-shadow: 0 -4px 15px rgba(0,0,0,0.2);
        }

        .confirm-button::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
            transition: left 0.5s;
        }

        .confirm-button:hover::before {
            left: 100%;
        }


</style>

<div class="custom-jewellery">
  <div class="first-screen">
    <div class="section-1" style="background-image: url('{{ section.settings.hero_image | image_url }}');">
    </div>
    <div class="section-2" >
      <div class="subtitle">{{ section.settings.hero_subtitle }}</div>
      <div class="title">{{ section.settings.hero_title }}</div>
      <div class="description">
      {{ section.settings.hero_description }}
      </div>
      <a id="create_cta_btn" class="cta">{{ section.settings.hero_cta_button }}</a>
    </div>
  </div>

  <div class="second-screen">
    <div id="necklace-card" class="card" style="background-image: url('{{ section.settings.necklace_image | image_url }}');">
      <div class="card-content">
        <h2>Necklace</h2>
        <a>Select</a>
      </div>
    </div>

    <!-- Anklet -->
    <div id="anklet-card" class="card" style="background-image: url('{{ section.settings.anklet_image | image_url }}')">
      <div class="card-content">
        <h2>Anklet</h2>
        <a>Select</a>
      </div>
    </div>

    <!-- Bracelet -->
    <div id="bracelet-card" class="card" style="background-image: url('{{ section.settings.bracelet_image | image_url }}')">
      <div class="card-content">
        <h2>Bracelet</h2>
        <a>Select</a>
      </div>
    </div>
  </div>

  <div class="third-screen" >
      <div class="third-screen-section-1" style="background-image: url('{{ section.settings.third_screen_bg_image | image_url }}');">
      </div>
      <div id="third-screen-section-2" class="third-screen-section-2" >

      </div>
  </div>

</div>
<script id="collections-data" type="application/json">
[
  {% for c in collections %}
    {
      "title": {{ c.title | json }},
      "handle": {{ c.handle | json }},
      "url": {{ c.url | json }},
      "description": {{ c.description | strip_html | json }},
      "products_count": {{ c.products_count | json }},
      "products": [
        {% for product in c.products %}
          {
            "id": {{ product.id | json }},
            "title": {{ product.title | json }},
            "handle": {{ product.handle | json }},
            "url": {{ product.url | json }},
            "price": {{ product.price | money | json }},
            "compare_at_price": {{ product.compare_at_price | money | json }},
            "available": {{ product.available | json }},
            "vendor": {{ product.vendor | json }},
            "product_type": {{ product.type | json }},
            "tags": {{ product.tags | json }},
            "featured_image": {{ product.featured_image | img_url: '600x' | json }},
            "images": [
              {% for img in product.images %}
                {{ img | img_url: '600x' | json }}{% unless forloop.last %},{% endunless %}
              {% endfor %}
            ],
            "variants": [
              {% for variant in product.variants %}
                {
                  "id": {{ variant.id | json }},
                  "title": {{ variant.title | json }},
                  "sku": {{ variant.sku | json }},
                  "price": {{ variant.price | money | json }},
                  "available": {{ variant.available | json }}
                }{% unless forloop.last %},{% endunless %}
              {% endfor %}
            ]
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
</script>

<script src="{{ 'vite-app.js' | asset_url }}" ></script>

<script>
 document.addEventListener('DOMContentLoaded', () => {
    let customProduct = {};

    // Get the button and the div
    const createButton = document.getElementById('create_cta_btn');
    const firstScreen = document.querySelector('.first-screen');
    const secondScreen = document.querySelector('.second-screen')
    const thirdScreen = document.querySelector('.third-screen')
    const thirdScreenSecondSection = document.getElementById('third-screen-section-2');

    // Add a click event listener to the button
    createButton.addEventListener('click', (event) => {
      event.preventDefault(); // Prevent default link behavior
      if (firstScreen) {
        firstScreen.style.display = 'none'; // Hide the div
        secondScreen.style.display = 'flex'; // show the div

        const necklaceCard = document.getElementById('necklace-card')
        const ankletCard = document.getElementById('anklet-card')
        const braceletCard = document.getElementById('bracelet-card')

        function showThirdScreen(productType){
          secondScreen.style.display = 'none';
          thirdScreen.style.display = 'flex';

          thirdScreenSecondSection.setAttribute('data-product-type', productType); 
        }

        necklaceCard.addEventListener('click',(event) => {
          customProduct['product_type'] = 'Necklace'
          showThirdScreen('necklace')
        })
        ankletCard.addEventListener('click',(event) => {
          customProduct['product_type'] = 'Anklet'
          showThirdScreen('anklet')
        })
        braceletCard.addEventListener('click',(event) => {
          customProduct['product_type'] = 'Bracelet'
          showThirdScreen('bracelet')
        })
      }
    });

  });
</script>

{% schema %}
{
  "name": "Bespoke Visualiser Page",
  "settings": [
    {
      "type": "header",
      "content": "Screen 1 Settings"
    },
    {
      "type": "text",
      "id": "hero_subtitle",
      "label": "Hero Section Subtitle",
      "default": "Your Story, Your stack"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Section Title",
      "default": "THE STORY CHAIN®"
    },
    {
      "type": "textarea",
      "id": "hero_description",
      "label": "Hero Section Description",
      "default": "Create your own personalised solid gold Story Chain® necklace, bracelet or anklet with our online builder, and mark every moment of your story with meaningful charms."
    },
    {
      "type": "text",
      "id": "hero_cta_button",
      "label": "Cta Button Text",
      "default": "CREATE YOUR STORY"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Section Background Image"
    },
    {
      "type": "header",
      "content": "Screen 2 Settings"
    },
    {
      "type": "image_picker",
      "id": "necklace_image",
      "label": "Necklace Background Image"
    },
    {
      "type": "image_picker",
      "id": "anklet_image",
      "label": "Anklet Background Image"
    },
    {
      "type": "image_picker",
      "id": "bracelet_image",
      "label": "Bracelet Background Image"
    },
    {
      "type": "header",
      "content": "Screen 3 Settings"
    },
    {
      "type": "image_picker",
      "id": "third_screen_bg_image",
      "label": "Third Screen Background Image"
    },
  ]
}
{% endschema %}